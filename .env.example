# Database Environment Variables
# The database URL for Prisma connection to PostgreSQL
DATABASE_URL="postgresql://postgres:postgres_secure_local@localhost:5432/securecbt?schema=public"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_local"
POSTGRES_DB="securecbt"
POSTGRES_PORT=5432

# Redis Environment Variables
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="redis_secure_local"

# Auth Service
AUTH_PORT=3001

# MFA secret encryption key (must be a high-entropy string, e.g. 32 bytes or longer)
MFA_ENCRYPTION_KEY="local_dev_mfa_encryption_key_32_bytes_long"

# Asymmetric RS256 Keypair (Optional in local dev - generated dynamically if omitted.
# In production, inject PEM-formatted string with newline replacements \n)
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Web3 Service Settings
WEB3_SERVICE_PORT=3004
WEB3_DATABASE_URL="postgresql://postgres:postgres_secure_local@localhost:5432/securecbt?schema=web3"
MAGIC_SECRET_KEY="sk_live_..."
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
